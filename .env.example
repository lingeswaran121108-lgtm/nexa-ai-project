# ==========================================
# NexaAI Configuration Environment Variables
# ==========================================

# 1. Application Settings
NEXT_PUBLIC_APP_NAME="NexaAI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 2. Supabase Configuration (PostgreSQL Database + Auth)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
# Server-side service role key (NEVER expose to frontend code)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# 3. AI Provider Configuration
# Choose your primary AI provider: "openai" | "anthropic" | "gemini" | "mock"
AI_PROVIDER="openai"
# OpenAI API Key (starts with sk-proj- or sk-)
OPENAI_API_KEY="sk-proj-your-openai-key-here"
# Anthropic API Key (optional fallback, starts with sk-ant-)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key-here"
# Google Gemini API Key (optional fallback)
GEMINI_API_KEY="AIzaSy-your-gemini-key-here"
# AI Model Selection
AI_MODEL_NAME="gpt-4o-mini"

# 4. Stripe Subscription & Payments Configuration
# Obtain from Stripe Dashboard (Test mode toggle enabled for dev)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
# Webhook secret from Stripe CLI or Webhooks Dashboard
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"

# Stripe Price IDs for Subscription Plans
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID="price_pro_monthly_id"
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID="price_pro_annual_id"
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_biz_monthly_id"
NEXT_PUBLIC_STRIPE_BUSINESS_ANNUAL_PRICE_ID="price_biz_annual_id"

# 5. Admin Secret Authorization Key (Optional extra shield for admin endpoints)
ADMIN_REGISTRATION_SECRET="nexa_super_admin_secret_token_2026"
